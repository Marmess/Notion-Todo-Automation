# --- Notion ---
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nom exact de la propriété "titre" dans ta base Notion
NOTION_TITLE_PROPERTY=Name

# Propriété utilisée pour savoir si une tâche est terminée
NOTION_STATUS_PROPERTY=Status
# Type de cette propriété: status | select | checkbox
NOTION_STATUS_PROPERTY_TYPE=status
# Valeurs considérées comme "terminé" (séparées par des virgules), utilisé si type=status ou select
NOTION_DONE_VALUES=Done,Terminé,Terminée

# --- SMTP (exemple avec Gmail: utiliser un "mot de passe d'application") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=mot_de_passe_application
MAIL_FROM=ton.adresse@gmail.com
MAIL_TO=ton.adresse.perso@gmail.com

# --- Planification ---
ENABLE_CRON=true
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=America/Toronto

# --- Divers ---
PORT=3000
# Optionnel: protège l'endpoint /send-tasks
TRIGGER_SECRET=
